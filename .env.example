# Copie para .env (nesta pasta) e ajuste. Somente valores PÚBLICOS: tudo que começa com
# VITE_ é incluído no JavaScript enviado ao navegador. Nunca coloque segredos aqui.

# Endereço da API REST do FHDOD, SEM o prefixo /api/v1 (o cliente HTTP o acrescenta).
# Desenvolvimento: backend iniciado na raiz do repositório da API (npm run dev), porta 3333.
# Produção: https://<endereço-da-api>. Deixe vazio para usar a mesma origem da página
# (/api/v1 encaminhado pelo proxy do Vite em desenvolvimento ou por um proxy reverso).
VITE_API_URL=http://localhost:3333
# development | test | production
VITE_APP_ENV=development

# O login administrativo é feito pela própria API (POST /auth/login, /auth/refresh e /auth/logout):
# não há outra variável de autenticação no frontend.

# A TV Wall (/tv) também usa só VITE_API_URL (E42 público). O hospital exibido é definido na API
# (TV_WALL_HOSPITAL_SHORT_NAME), nunca aqui.

# Variáveis lidas do TERMINAL (não deste arquivo), opcionais:
#   VITE_PORT          porta do servidor de desenvolvimento (padrão 5173)
#   VITE_PROXY_TARGET  destino do proxy /api com VITE_API_URL vazia (padrão http://localhost:3333)
#   FHDOD_API_DIR      pasta do clone da API, para a E2E (ex.: ../fhdod-experiencia-paciente)
#   E2E_EVIDENCE_DIR   pasta das capturas da E2E (padrão test-results/evidencias)
